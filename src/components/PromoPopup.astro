---
/* PromoPopup — poster pricelist OMODA | JAECOO Semarang, tampil saat beranda
   dibuka. Bisa ditutup (X / backdrop / Esc).

   SENGAJA TANPA localStorage: pop-up ini memuat daftar harga yang berubah
   tiap bulan, jadi ia harus muncul lagi pada kunjungan berikutnya. Versi
   sebelumnya menyimpan penanda "sudah ditutup" selamanya, sehingga pengunjung
   lama tidak pernah melihat harga yang diperbarui.

   Gambarnya berkas lokal di public/, bukan Supabase Storage, supaya
   mengganti poster cukup lewat repo. */
import Icon from './Icon.astro';
import { site } from '../lib/site';
import { waLink, pesanPenawaran } from '../lib/whatsapp';

const POSTER = '/pricelist-omoda-jaecoo.webp';
const wa = waLink(
  site.whatsapp,
  `${pesanPenawaran(site)}\n\nSaya lihat pricelist terbaru di website.`,
);
---
<div id="promo-popup" class="ppop" hidden>
  <div class="ppop-backdrop" data-ppop-close aria-hidden="true"></div>
  <div class="ppop-card" role="dialog" aria-modal="true" aria-label={`Pricelist ${site.brand}`}>
    <button type="button" class="ppop-close" data-ppop-close aria-label="Tutup pricelist">
      <Icon name="close" size={20} />
    </button>
    <div class="ppop-scroll">
      <img class="ppop-img" src={POSTER} width="1000" height="1419"
         alt="Pricelist terbaru OMODA dan JAECOO Semarang: OMODA 04 EV open pre-book, JAECOO J8 SHS, J7 SHS, dan J5 EV."
         loading="eager" decoding="async" />
    </div>
    <a class="ppop-wa" href={wa} target="_blank" rel="noopener noreferrer">
      <Icon name="whatsapp" size={22} /> <span>Tanya harga via WhatsApp</span>
    </a>
  </div>
</div>

<script>
  const el = document.getElementById('promo-popup');
  if (el) {
    el.hidden = false;
    requestAnimationFrame(() => el.classList.add('is-open'));
    const close = () => {
      el.classList.remove('is-open');
      window.setTimeout(() => { el.hidden = true; }, 220);
    };
    el.querySelectorAll('[data-ppop-close]').forEach((b) => b.addEventListener('click', close));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !el.hidden) close(); });
  }
</script>

<style>
  .ppop {
    position: fixed; inset: 0; z-index: 1000;
    display: grid; place-items: center;
    padding: var(--space-lg);
  }
  .ppop[hidden] { display: none; }
  .ppop-backdrop {
    position: absolute; inset: 0;
    background: rgba(8, 12, 16, 0.62);
    opacity: 0; transition: opacity var(--dur) var(--ease);
  }
  .ppop.is-open .ppop-backdrop { opacity: 1; }

  .ppop-card {
    position: relative; z-index: 1;
    width: min(26rem, 100%);
    max-height: 92vh;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
    transform: translateY(12px) scale(0.98); opacity: 0;
    transition: transform var(--dur) var(--ease-out), opacity var(--dur) var(--ease);
  }
  .ppop.is-open .ppop-card { transform: none; opacity: 1; }

  /* Poster potret (1000x1419) gampang melampaui layar ponsel, jadi
     tingginya dibatasi dan kartunya yang menggulir. */
  .ppop-img { display: block; width: 100%; height: auto; }
  .ppop-scroll { max-height: min(72vh, 40rem); overflow-y: auto; }

  .ppop-close {
    position: absolute; top: var(--space-xs); right: var(--space-xs); z-index: 2;
    display: grid; place-items: center;
    width: 2.25rem; height: 2.25rem; border-radius: 50%;
    background: rgba(8, 12, 16, 0.55); color: #fff;
    cursor: pointer; backdrop-filter: blur(4px);
    transition: background var(--dur) var(--ease);
  }
  .ppop-close:hover { background: rgba(8, 12, 16, 0.78); }

  .ppop-wa {
    display: flex; align-items: center; justify-content: center; gap: var(--space-2xs);
    width: 100%; min-height: 3.25rem; flex: none;
    background: var(--wa-action, #1FA855); color: #fff;
    font-weight: var(--fw-bold); font-size: var(--fs-lead);
    transition: background var(--dur) var(--ease);
  }
  .ppop-wa :global(.icon) { color: #fff; }
  .ppop-wa:hover { background: var(--wa-action-strong, #178043); }

  @media (prefers-reduced-motion: reduce) {
    .ppop-backdrop, .ppop-card { transition: none; }
  }
</style>
